          ],
          "queryFormulas": [],
          "queryTraceOperator": []
        },
        "clickhouse_sql": [
          {
            "disabled": false,
            "legend": "",
            "name": "A",
            "query": "WITH\n  series AS (\n    SELECT DISTINCT\n      fingerprint,\n      JSONExtractString(labels, 'deployment.environment') AS environment,\n      JSONExtractString(labels, 'repo_full_name') AS repository,\n      JSONExtractString(labels, 'workflow_path') AS workflow,\n      JSONExtractString(labels, 'job_name') AS job_name,\n      JSONExtractString(labels, 'job_key') AS job_key,\n      JSONExtractString(labels, 'service.instance.id') AS runner\n    FROM signoz_metrics.distributed_time_series_v4\n    WHERE metric_name IN ('system.cpu.utilization', 'system.memory.usage')\n      AND JSONExtractString(labels, 'service.name') = 'runs-on-agent'\n      AND JSONExtractString(labels, 'job_name') != ''\n      AND JSONExtractString(labels, 'state') IN ('idle', 'used')\n      AND unix_milli >= intDiv($start_timestamp_ms, 3600000) * 3600000\n      AND unix_milli < $end_timestamp_ms\n  ),\n  -- GLOBAL joins: on a multi-shard cluster, ClickHouse rejects a join whose\n  -- right side reads a distributed table unless it is broadcast.\n  -- A runner reports job_key once its job starts. Group by the key so matrix\n  -- combinations count together, and keep only samples taken under the key;\n  -- runners from agents without job_key fall back to the display name.\n  runner_keys AS (\n    SELECT runner, max(job_key) AS runner_key\n    FROM series\n    GROUP BY runner\n  ),\n  job_series AS (\n    SELECT\n      series.fingerprint, series.environment, series.repository, series.workflow,\n      series.job_name, series.runner,\n      if(runner_keys.runner_key != '', runner_keys.runner_key, series.job_name) AS job\n    FROM series\n    GLOBAL INNER JOIN runner_keys USING (runner)\n    WHERE series.job_key = runner_keys.runner_key\n  ),\n  per_runner AS (\n    SELECT\n      environment, repository, workflow, job, runner,\n      any(job_name) AS job_name,\n      -- OrNull: a runner without one of the metrics (older agents export no\n      -- memory bytes) must not turn the job's averages into NaN.\n      1 - avgOrNullIf(value, metric_name = 'system.cpu.utilization') AS busy,\n      avgOrNullIf(value, metric_name = 'system.memory.usage') AS memory,\n      maxOrNullIf(value, metric_name = 'system.memory.usage') AS memory_max\n    FROM signoz_metrics.distributed_samples_v4\n    GLOBAL INNER JOIN job_series USING (fingerprint)\n    WHERE metric_name IN ('system.cpu.utilization', 'system.memory.usage')\n      AND unix_milli >= $start_timestamp_ms\n      AND unix_milli < $end_timestamp_ms\n    GROUP BY environment, repository, workflow, job, runner\n  )\nSELECT\n  job AS `Job`,\n  count() AS `Runners`,\n  uniqExact(job_name) AS `Variants`,\n  round(100 * avg(busy), 1) AS `Avg CPU busy`,\n  -- quantileExact returns the upper middle value; this one interpolates.\n  round(100 * quantileExactInclusive(0.5)(busy), 1) AS `Median CPU busy`,\n  avg(memory) AS `Avg memory`,\n  quantileExactInclusive(0.5)(memory) AS `Median memory`,\n  max(memory_max) AS `Peak memory`,\n  workflow AS `Workflow`,\n  repository AS `Repository`,\n  environment AS `Environment`\nFROM per_runner\nGROUP BY job, workflow, repository, environment\nORDER BY `Runners` DESC, `Avg CPU busy` DESC\nLIMIT 200"
          }
        ],
        "id": "fde7bc3d-bad2-5d98-bba4-4c3b1bdef7e9",
