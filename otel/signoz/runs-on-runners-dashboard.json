      "nullZeroValues": "null",
      "opacity": "1",
      "panelTypes": "table",
      "query": {
        "builder": {
          "queryData": [
            {
              "aggregations": [
                {
                  "metricName": "system.cpu.utilization",
                  "reduceTo": "avg",
                  "spaceAggregation": "avg",
                  "temporality": "",
                  "timeAggregation": "avg"
                }
              ],
              "dataSource": "metrics",
              "disabled": false,
              "expression": "A",
              "filter": {
                "expression": "resource.service.name = 'runs-on-agent' AND resource.deployment.environment IN $Environment AND resource.repo_full_name IN $Repository AND resource.workflow_path IN $Workflow AND resource.job_key IN $Job AND resource.job_key EXISTS"
              },
              "filters": {
                "items": [],
                "op": "AND"
              },
              "functions": [],
              "groupBy": [],
              "having": {
                "expression": ""
              },
              "legend": "",
              "limit": null,
